# ─────────────────────────────────────────────────────────────────────────────
# InvestIQ — Frontend Environment Variables
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. Never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL (no trailing slash).
# Local dev: http://localhost:8080
# Production: https://api.investiq.fit
VITE_API_URL=http://localhost:8080

# Set to true to use DevAuth (no Clerk login required).
# Must match DEV_MODE=true on the backend.
VITE_DEV_MODE=false

# Clerk publishable key — starts with pk_test_ (dev) or pk_live_ (prod).
# Not used when VITE_DEV_MODE=true.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY

# Plaid environment shown to the Plaid Link widget.
# Must match PLAID_ENV on the backend. Options: sandbox | production
VITE_PLAID_ENV=sandbox

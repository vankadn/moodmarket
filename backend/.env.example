# ─────────────────────────────────────────────────────────────────────────────
# InvestIQ — Backend Environment Variables
# Copy this file to .env and fill in real values.
# .env is gitignored. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────


# ─── Dev / Mock flags ────────────────────────────────────────────────────────

# Set to true to skip all external calls — only MongoDB is required.
# Overrides AI_PROVIDER, MARKET_PROVIDER, FINANCIAL_DATA_PROVIDER,
# BROKERAGE_PROVIDER, NEWS_PROVIDER, DOCUMENT_EXTRACTOR, MARKET_CALENDAR,
# SNAPTRADE_PROVIDER all to mock, and sets DEV_MODE=true automatically.
MOCK_ALL=false

# Set to true to bypass Clerk auth and auto-login as DEV_USER_ID below.
# Logic lives only in infrastructure/auth/factory.go — nowhere else.
DEV_MODE=false

# Hardcoded identity used when DEV_MODE=true
DEV_USER_ID=dev_user_local
DEV_USER_EMAIL=dev@investiq.local
DEV_USER_NAME=Dev User


# ─── Server ──────────────────────────────────────────────────────────────────

# HTTP port. Railway sets this automatically; locally defaults to 8080.
PORT=8080

# Comma-free origin allowed by CORS middleware.
# Local frontend: http://localhost:5173
# Production: https://www.investiq.fit
ALLOWED_ORIGIN=http://localhost:5173


# ─── Database ────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string. For local dev: mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017


# ─── Auth (Clerk) ────────────────────────────────────────────────────────────

# Clerk secret key — starts with sk_test_ (dev) or sk_live_ (prod).
# Not needed when DEV_MODE=true.
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY


# ─── AI / Advisor ────────────────────────────────────────────────────────────

# Which advisor to use. Options: claude | mock
# mock returns a fixed three-fund portfolio with no API calls.
AI_PROVIDER=claude

# Required when AI_PROVIDER=claude or DOCUMENT_EXTRACTOR=claude.
# Starts with sk-ant-api03-
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_ANTHROPIC_API_KEY

# Which document extractor to use. Options: claude | mock
DOCUMENT_EXTRACTOR=claude


# ─── Market Data ─────────────────────────────────────────────────────────────

# MARKET_PROVIDER=finnhub for real-time | polygon for free-tier prev-day
# Options: finnhub | polygon | mock
MARKET_PROVIDER=polygon

# Which news provider to use. Options: polygon | mock
NEWS_PROVIDER=polygon

# Polygon.io API key — used by both MARKET_PROVIDER and NEWS_PROVIDER when set to polygon.
# Free tier gives unlimited previous-day OHLCV + reference news (SPY-tagged).
POLYGON_API_KEY=YOUR_POLYGON_API_KEY

# Finnhub API key — required when MARKET_PROVIDER=finnhub.
# Sign up at finnhub.io; free tier includes real-time US stock quotes.
FINNHUB_API_KEY=your_finnhub_key_here

# How long to cache Finnhub quote responses (per-ticker and snapshot).
# Default 5m. Lower values give fresher prices at the cost of more API calls.
FINNHUB_CACHE_TTL=5m

# Which market calendar to use. Options: nyse | mock
# nyse uses the algorithmic NYSE holiday calendar (no network call, no key needed).
MARKET_CALENDAR=nyse


# ─── Banking (Plaid) ─────────────────────────────────────────────────────────

# Which financial data provider to use. Options: plaid | mock
FINANCIAL_DATA_PROVIDER=plaid

# Plaid client ID — visible in the Plaid dashboard under Team Settings.
PLAID_CLIENT_ID=YOUR_PLAID_CLIENT_ID

# Plaid secret — environment-specific (sandbox vs production).
PLAID_SECRET=YOUR_PLAID_SECRET

# Plaid environment. Options: sandbox | development | production
PLAID_ENV=sandbox

# How long to cache Plaid balance responses.
# Reduces API calls during dev; production default is 5m.
PLAID_CACHE_TTL=5m

# AES-256-GCM encryption key for Plaid access_token values stored in MongoDB.
# Must be exactly 32 bytes, base64-encoded.
# Generate: openssl rand -base64 32
PLAID_TOKEN_ENCRYPTION_KEY=YOUR_BASE64_ENCODED_32_BYTE_KEY


# ─── Brokerage (Alpaca) ──────────────────────────────────────────────────────

# Which brokerage provider to use. Options: alpaca | mock
# mock bypasses all trade execution — safe for local dev.
BROKERAGE_PROVIDER=alpaca

# Note: Alpaca credentials are per-user and stored AES-256-GCM encrypted in
# MongoDB (BrokerageConnection). There are no shared env-var Alpaca keys.
# Users connect their own Alpaca accounts via POST /brokerage/connections.


# ─── Portfolio Aggregation (SnapTrade) ───────────────────────────────────────

# Which portfolio aggregator to use. Options: snaptrade | mock
SNAPTRADE_PROVIDER=snaptrade

# SnapTrade client ID — issued when you register at snaptrade.com.
SNAPTRADE_CLIENT_ID=YOUR_SNAPTRADE_CLIENT_ID

# SnapTrade consumer key — HMAC-SHA256 signing key for all API requests.
SNAPTRADE_CONSUMER_KEY=YOUR_SNAPTRADE_CONSUMER_KEY


# ─── Notifications ───────────────────────────────────────────────────────────

# Email and SMS are independent channels — both can be active at the same time.
# stdout logging is always on and does not require any env vars.

# Email channel. Options: resend  (omit or leave blank to disable email)
EMAIL_PROVIDER=resend

# Resend — required when EMAIL_PROVIDER=resend
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
RESEND_FROM=noreply@investiq.fit

# SMS channel. Options: twilio  (omit or leave blank to disable SMS)
SMS_PROVIDER=twilio

# Twilio — required when SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
# E.164 format, e.g. +14155552671
TWILIO_FROM=+1XXXXXXXXXX


# ─── Scheduler ───────────────────────────────────────────────────────────────

# How often the auto-invest scheduler ticks.
# Default: 1h (production). Use 1m or 30s for faster local testing.
# Valid Go duration strings: 30s, 5m, 1h, 24h
AUTO_INVEST_TICK=1h
